{
  "name": "zapret-app",
  "version": "1.11.8",
  "description": "Skvoz — пульт для zapret и Telegram-прокси",
  "main": "dist/main/main.js",
  "author": "ProtheticGlitch",
  "license": "MIT",
  "homepage": "https://tw1xtyq.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/tw1xtyq/skvoz"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "node scripts/clean.js dist && tsc && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "icons": "node scripts/generate-icon.js",
    "logo": "electron scripts/render-logo.js",
    "installer-art": "electron scripts/render-installer-art.js",
    "start": "scripts\\start-win.cmd",
    "dev": "npm run vendor && tsc && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js && node scripts/run-dev.js",
    "dev:admin": "scripts\\start-win.cmd",
    "pack": "npm run vendor && npm run build && npm run icons && electron-builder --win --x64",
    "pack:portable": "npm run vendor && npm run build && npm run icons && electron-builder --win portable --x64",
    "pack:setup": "npm run vendor && npm run build && npm run icons && electron-builder --win nsis --x64",
    "vendor": "node scripts/fetch-vendor.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node scripts/clean.js dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "build": {
    "appId": "com.protheticglitch.zapret-app",
    "productName": "Skvoz",
    "copyright": "Copyright © 2026 ProtheticGlitch",
    "afterPack": "scripts/patch-win-exe.js",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/amneziawg",
        "to": "amneziawg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/wgcf",
        "to": "wgcf",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/zapret",
        "to": "zapret",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skvoz",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "installerHeader": "installerHeader.bmp",
      "include": "assets/installer.nsh",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "uninstallDisplayName": "Skvoz",
      "artifactName": "Skvoz-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Skvoz-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1",
    "typescript": "^5.7.2"
  }
}
